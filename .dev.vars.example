# Local development only. Copy to .dev.vars (gitignored), then replace all placeholders.
# Generate an RSA signing key and kid with: node scripts/generate-jwk.mjs
# Use wrangler secret put for production passwords, client secrets and private keys.
ZEROAUTH_CLIENT_ID=zeroauth-local-client
ZEROAUTH_CLIENT_SECRET=replace-me-with-a-long-random-client-secret
ZEROAUTH_PASSWORD=replace-me-with-your-shared-password
ZEROAUTH_ALLOWED_EMAIL_DOMAINS=example.com,second.example
ZEROAUTH_ALLOWED_REDIRECT_URIS=https://client.example/callback
ZEROAUTH_PRIVATE_JWK=replace-me-with-the-generated-private-jwk-json
ZEROAUTH_KID=replace-me-with-the-generated-kid
ZEROAUTH_ISSUER=https://localhost:8787
ZEROAUTH_AUTH_CODE_TTL_SECONDS=60
ZEROAUTH_TOKEN_TTL_SECONDS=3600
